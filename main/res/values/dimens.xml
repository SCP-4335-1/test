<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        omarchy-launch-walker invokes widths and heights that are
        Hyprland-compositor pixels on a desktop monitor. We
        keep the same *proportions* (a wide-ish, short popup rather than
        a tall full-screen list) but size them for a phone: walker_width
        becomes a max-width cap so the popup doesn't stretch edge-to-edge
        on tablets, and the height values become the results list's
        scrollable height.
    -->
    <dimen name="walker_width">360dp</dimen>
    <dimen name="walker_min_height">168dp</dimen>
    <dimen name="walker_max_height">280dp</dimen>
</resources>
