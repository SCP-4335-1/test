<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/scrim"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_omarchy_menu"
        android:padding="16dp">

        <TextView
            android:id="@+id/widgetPreviewLabel"
            style="@style/Text.Terminal.Prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <FrameLayout
            android:id="@+id/widgetPreviewContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/bg_panel"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/widgetPreviewCancel"
                style="@style/Text.Terminal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/neon_red"
                android:text="@string/widget_preview_cancel" />

            <TextView
                android:id="@+id/widgetPreviewConfirm"
                style="@style/Text.Terminal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/neon_cyan"
                android:text="@string/widget_preview_add" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
