<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_context_menu"
    android:padding="6dp">

    <TextView
        style="@style/Text.Terminal.Dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/prompt_user" />

    <TextView
        android:id="@+id/menuWidgets"
        style="@style/Text.Terminal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="?android:attr/selectableItemBackground"
        android:text="@string/long_press_menu_widgets" />

    <TextView
        android:id="@+id/menuWallpaper"
        style="@style/Text.Terminal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="?android:attr/selectableItemBackground"
        android:text="@string/long_press_menu_wallpaper" />

    <TextView
        android:id="@+id/menuSettings"
        style="@style/Text.Terminal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="?android:attr/selectableItemBackground"
        android:text="@string/long_press_menu_settings" />

</LinearLayout>
